# =============================================================================
# IMAGEN SOLO PARA DESARROLLO — base para `docker compose` con hot reload
# =============================================================================
# Esta imagen NO es la que desplegarías a producción. Su objetivo es:
#   - Fijar la versión de Node y tener node_modules ya instalados en la imagen.
#   - En tiempo de ejecución, Compose MONTA tu carpeta del proyecto sobre /app,
#     de modo que editas archivos en el host y Next (npm run dev) recarga dentro
#     del contenedor.
#
# Por qué no copiamos el código aquí: el bind mount `.:/app` sobrescribiría
# cualquier COPY del código; solo necesitamos que `npm ci` deje dependencias
# coherentes con el lockfile. Los volúmenes nombrados en compose evitan que
# el node_modules del host (vacío u otro OS) pise el del contenedor.
# =============================================================================

# syntax=docker/dockerfile:1

FROM node:22-bookworm-slim
WORKDIR /app

# Misma variable que en producción: sin telemetría de Next hacia Vercel.
ENV NEXT_TELEMETRY_DISABLED=1

# Solo manifiestos de dependencias → instalación reproducible con TODAS las
# devDependencies (TypeScript, ESLint, Tailwind, etc.) necesarias para `next dev`.
COPY package.json package-lock.json ./
RUN npm ci

# Puerto en el que Next escucha por defecto; Compose lo publica al host.
EXPOSE 3000

# Arranca el servidor de desarrollo. El script está en package.json como
# "next dev --hostname 0.0.0.0" para que sea accesible desde fuera del contenedor
# (obligatorio en Docker; sin eso solo escucharía en localhost dentro del contenedor).
CMD ["npm", "run", "dev"]
